---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Directory from '../components/Directory.astro';

type Tag = CollectionEntry<'posts'>['data']['tags'][number];

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const tagged = (tag: Tag) => posts.filter((post) => post.data.tags.includes(tag));

const columns = [
	{ id: 'cyber', title: 'Cyber/CTF Writeups', posts: tagged('cyber'), showDate: false },
	{ id: 'recent', title: 'Recent posts', posts: tagged('general').slice(0, 4), showDate: true },
	{ id: 'hiking', title: 'Hiking Adventures', posts: tagged('adventure'), showDate: false },
];

const plural = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;
---

<Layout title="Home">
	<div class="home">
		<Window n="01" label="whoami" class="intro">
				<p>
					welcome! my name is <mark>Hendry</mark>. i go by <mark>justanotherinternetguy</mark> or
					<mark>nyaarch</mark> online (i can also be found as <mark>gentoouinely</mark> or
					<mark>internetguy</mark>).
				</p>
				<p>
					i am a freshman at <mark>Cornell University</mark> studying
					<mark>computer science</mark>, <mark>mathematics</mark>, and <mark>linguistics</mark>. at
					Cornell, I do research as a part of the
					<mark><a href="https://milstein-program.as.cornell.edu/hendry-xu" target="_blank" rel="noopener noreferrer">Milstein Program</a></mark>.
					i am generally interested in computer science, engineering, physics, biology,
					linguistics, and deep learning.
					<br />
					<br />
					i currently conduct research in the intersection of speech, linguistics, deep learning,
					and human-machine interaction. right now, i am working on <mark>world models</mark> to
					simulate natural/biological environments and
					<a href="https://ieeexplore.ieee.org/document/11288978" target="_blank" rel="noopener noreferrer">end-to-end speech conversion.</a>
				</p>
				<p>
					i interned for
					<a href="https://www.synclabs.co/" target="_blank" rel="noopener noreferrer">Sync Labs</a>
					to develop facial &amp; action recognition on IoT devices. i competed at the
					<a href="https://isef.net/project/cbio057-stutterzero-end-to-end-correction-of-stutters" target="_blank" rel="noopener noreferrer">International Science and Engineering Fair 2025 (1st place, CBIO)</a>,
					and
					<a href="https://isef.net/project/sftd041-terraformer-a-soil-world-model" target="_blank" rel="noopener noreferrer">ISEF 2026 (3rd place, SFTD + AAAI award)</a>.
				</p>
				<p>
					i worked for
					<a href="https://www.fluencyai.net/" target="_blank" rel="noopener noreferrer">FluencyAI</a>
					developing end-to-end AI pipelines and digital twins to help people who stutter
					communicate more confidently.
				</p>
				<ul class="list">
					<li>i hold a <a href="https://www.arrl.org/getting-your-technician-license" target="_blank" rel="noopener noreferrer">Technician license</a> for ham radio!</li>
					<li>
						i use <a href="https://www.gentoo.org/" target="_blank" rel="noopener noreferrer">gentoo</a>
						and <a href="https://archlinux.org/" target="_blank" rel="noopener noreferrer">arch linux</a>
					</li>
					<li>
						i am a co-founder and maintainer of the
						<a href="https://cornelltilde.com/" target="_blank" rel="noopener noreferrer">tilde@Cornell</a>,
						Cornell's student-run tildenet and Linux User's Group.
					</li>
					<li>
						building with <a href="https://armada.build/" target="_blank" rel="noopener noreferrer">Armada</a>
					</li>
					<li>
						in my free time, i enjoy learning conlangs and linguistics. i am learning
						<a href="https://eo.wikipedia.org/wiki/Esperanto" target="_blank" rel="noopener noreferrer">esperanto</a>
						and <a href="https://tokipona.org/" target="_blank" rel="noopener noreferrer">toki pona.</a>
					</li>
					<li>i also am a fan of aviation, especially military aircraft</li>
					<li>
						i am a
						<a href="https://en.wikipedia.org/wiki/User:Justanotherinternetguy" target="_blank" rel="noopener noreferrer">wikipedia editor</a>
					</li>
					<li>
						i do CTFs with
						<a href="https://spl.team/" target="_blank" rel="noopener noreferrer">squid proxy lovers</a>
						and
						<a href="https://cornellcyber.club/" target="_blank" rel="noopener noreferrer">cornell cybersec</a>
					</li>
					<li>contact me on discord <mark>@justanotherinternetguy</mark></li>
				</ul>
			
		</Window>

		<div class="dirs">
			{
				columns.map((col, i) => (
					<Window id={col.id} n={String(i + 2).padStart(2, '0')} title={col.title} label={plural(col.posts.length)}>
						<Directory
							compact
							showDate={col.showDate}
							entries={col.posts.map((post) => ({
								href: `/posts/${post.id}.html`,
								title: post.data.title,
								date: post.data.date,
							}))}
						/>
					</Window>
				))
			}
		</div>
	</div>
</Layout>
