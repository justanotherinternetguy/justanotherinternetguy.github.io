---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Icon from '../components/Icon.astro';
import { quotes } from '../data/quotes';
import '../styles/quotes.css';

const width = Math.max(3, String(quotes.length).length);
const pad = (i: number) => String(i + 1).padStart(width, '0');
---

<Layout title="Quotes">
	<Window id="archive" class="archive" title="Quotes" headingLevel={1} label={`${quotes.length} ${quotes.length === 1 ? 'entry' : 'entries'}`}>
		<ol class="quotes">
			{
				quotes.map((quote, i) => (
					<li class="quote">
						<span class="quote-n" aria-hidden="true">
							<Icon name="quote" size={32} />
							<span>{pad(i)}</span>
						</span>
						<figure>
							<blockquote>
								<p>{quote.text}</p>
							</blockquote>
							{quote.by && <figcaption>{quote.by}</figcaption>}
						</figure>
					</li>
				))
			}
		</ol>
	</Window>
</Layout>
