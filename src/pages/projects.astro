---
// One window per project. Edit the list in src/data/projects.ts.
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import { projects, kinds } from '../data/projects';
import '../styles/projects.css';

const external = (href: string) => /^https?:\/\//.test(href);
const count = (kind: string) => projects.filter((p) => p.kind === kind).length;
const awards = projects.filter((p) => p.award).length;
const filters = [{ kind: 'all', n: projects.length }, ...kinds.map((kind) => ({ kind, n: count(kind) }))];
const slug = (name: string) => `p-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Year strip: one column per year, one dot per project.
const years = projects.map((p) => Number(p.year));
const timeline = Array.from({ length: Math.max(...years) - Math.min(...years) + 1 }, (_, k) => {
	const year = Math.min(...years) + k;
	const items = projects.filter((p) => Number(p.year) === year);
	// Awarded projects lead each year.
	return { year, items: [...items.filter((p) => p.award), ...items.filter((p) => !p.award)] };
});
---

<Layout title="Projects">
	<h1 class="sr-only">Projects</h1>

	<div class="shell">
		<div class="shell-filters" role="group" aria-label="Filter projects" hidden>
			{
				filters.map((f) => (
					<button type="button" class="shell-filter" data-kind={f.kind} aria-pressed={f.kind === 'all' ? 'true' : 'false'}>
						{f.kind} <span class="shell-filter-n">{f.n}</span>
					</button>
				))
			}
		</div>
		<div class="tl" aria-hidden="true">
			{
				timeline.map((col) => (
					<div class="tl-year">
						<div class="tl-dots">
							{col.items.length === 0 && <span class="tl-none" />}
							{col.items.map((p) => (
								<a
									class:list={['tl-dot', { 'tl-won': p.award }]}
									href={`#${slug(p.name)}`}
									data-for={slug(p.name)}
									data-name={p.name}
									tabindex="-1"
								/>
							))}
						</div>
						<span class="tl-label">'{String(col.year).slice(2)}</span>
					</div>
				))
			}
		</div>
		<p class="shell-out" aria-live="polite">
			<span data-shell-count>{projects.length}</span> entries · <span class="shell-won"><span data-shell-won>{awards}</span> awarded</span>
		</p>
	</div>

	<div class="projects-wrap">
		<div class="projects">
			{
				projects.map((project, i) => (
					<Window
						as="article"
						id={slug(project.name)}
						n={String(i + 1).padStart(2, '0')}
						title={project.name}
						label={`${project.kind} · ${project.year}`}
						class:list={['project', { 'project-featured': project.featured, 'project-won': project.award }]}
						style={`--i: ${i}`}
						data={{ kind: project.kind }}
					>
						<span slot="bar" class="project-led" aria-hidden="true" />
						<span slot="bar" class="project-trace" aria-hidden="true" />
						{project.blurb && <p class="project-blurb">{project.blurb}</p>}
						{(project.award || project.context) && (
							<p class="project-meta">
								{project.award && <span class="project-award">{project.award}</span>}
								{project.award && project.context && ' @ '}
								{project.context && <span>{project.context}</span>}
							</p>
						)}
						<ul class="project-links">
							{project.links.map((link) => (
								<li>
									<a
										href={link.href}
										target={external(link.href) ? '_blank' : undefined}
										rel={external(link.href) ? 'noopener noreferrer' : undefined}
									>
										{link.label}
										{external(link.href) && <span class="project-ext" aria-hidden="true">↗</span>}
									</a>
								</li>
							))}
						</ul>
					</Window>
				))
			}
		</div>
	</div>

	<script>
		const root = document.documentElement;
		const still = () => root.dataset.motion === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;

		const group = document.querySelector<HTMLElement>('.shell-filters');
		const countEl = document.querySelector<HTMLElement>('[data-shell-count]');
		const wonEl = document.querySelector<HTMLElement>('[data-shell-won]');
		const cards = [...document.querySelectorAll<HTMLElement>('.project')];
		const dots = new Map(
			[...document.querySelectorAll<HTMLElement>('.tl-dot')].map((d) => [d.dataset.for, d] as const),
		);

		// ── Filters ──────────────────────────────────────────────
		if (group && countEl && wonEl) {
			group.hidden = false;
			const buttons = [...group.querySelectorAll<HTMLButtonElement>('.shell-filter')];

			const apply = (kind: string) => {
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === kind)));
				let shown = 0;
				let won = 0;
				for (const card of cards) {
					const match = kind === 'all' || card.dataset.kind === kind;
					card.hidden = !match;
					dots.get(card.id)?.classList.toggle('is-off', !match);
					if (!match) continue;
					if (card.classList.contains('project-won')) won++;
					// Redraw the window frame, staggered by its new position.
					card.style.setProperty('--i', String(shown++));
					card.style.animation = 'none';
					void card.offsetWidth;
					card.style.animation = '';
				}
				countEl.textContent = String(shown);
				wonEl.textContent = String(won);
			};

			group.addEventListener('click', (e) => {
				const button = (e.target as HTMLElement).closest<HTMLButtonElement>('.shell-filter');
				if (button?.dataset.kind) apply(button.dataset.kind);
			});
		}

		// ── Year strip ↔ windows ─────────────────────────────────
		const light = (card: HTMLElement, on: boolean) => {
			card.classList.toggle('is-lit', on);
			dots.get(card.id)?.classList.toggle('is-lit', on);
		};
		for (const card of cards) {
			card.addEventListener('pointerenter', () => light(card, true));
			card.addEventListener('pointerleave', () => light(card, false));
		}
		for (const [id, dot] of dots) {
			const card = id ? document.getElementById(id) : null;
			if (!card) continue;
			dot.addEventListener('pointerenter', () => light(card, true));
			dot.addEventListener('pointerleave', () => light(card, false));
			dot.addEventListener('click', (e) => {
				e.preventDefault();
				if (card.hidden) group?.querySelector<HTMLButtonElement>('[data-kind="all"]')?.click();
				card.scrollIntoView({ block: 'center', behavior: still() ? 'auto' : 'smooth' });
				card.classList.remove('is-pinged');
				void card.offsetWidth;
				card.classList.add('is-pinged');
			});
		}

		// ── Title decode on hover ────────────────────────────────
		const glyphs = '!<>-_\\/[]{}=+*^?#01';
		const scramble = (el: HTMLElement) => {
			const text = el.dataset.text ?? (el.dataset.text = el.textContent ?? '');
			if (el.dataset.busy || still()) return;
			el.dataset.busy = '1';
			el.setAttribute('aria-label', text);
			const start = performance.now();
			const tick = (now: number) => {
				const done = Math.floor(((now - start) / 420) * text.length);
				el.textContent = [...text]
					.map((ch, i) => (i < done || ch === ' ' ? ch : glyphs[(Math.random() * glyphs.length) | 0]))
					.join('');
				if (done < text.length) requestAnimationFrame(tick);
				else {
					el.textContent = text;
					delete el.dataset.busy;
				}
			};
			requestAnimationFrame(tick);
		};

		// ── Cursor spotlight ─────────────────────────────────────
		for (const card of cards) {
			const title = card.querySelector<HTMLElement>('.win-title');
			card.addEventListener('pointerenter', () => title && scramble(title));
			card.addEventListener('focusin', () => title && scramble(title));
			card.addEventListener('pointermove', (e) => {
				const r = card.getBoundingClientRect();
				card.style.setProperty('--mx', `${e.clientX - r.left}px`);
				card.style.setProperty('--my', `${e.clientY - r.top}px`);
			});
		}
	</script>
</Layout>
