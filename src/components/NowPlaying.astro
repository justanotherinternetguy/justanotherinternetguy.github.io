---
// Footer music player. To change the song, paste a new YouTube link
// into `url` and update `title` and `artist` to match.
const track = {
	url: 'https://www.youtube.com/watch?v=0Md0E5icspA',
	title: 'Cups (When I’m Gone)',
	artist: 'Anna Kendrick',
};

// Accepts youtube.com/watch?v=ID, youtu.be/ID and music.youtube.com links.
const link = new URL(track.url);
const videoId = link.searchParams.get('v') ?? link.pathname.split('/').pop();
---

<section class="np" data-video={videoId} data-state="idle" aria-label="Music player">
	<button class="np-btn" type="button" aria-label={`Play ${track.title}`}>
		<svg class="np-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
		<svg class="np-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
	</button>

	<span class="np-eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
	<span class="np-status" aria-live="polite">standby</span>

	<a class="np-track" href={track.url} target="_blank" rel="noopener noreferrer">
		<span class="np-title">{track.title}</span>
		<span class="np-artist">{track.artist}</span>
	</a>

	<span
		class="np-bar"
		role="slider"
		tabindex="0"
		aria-label="Seek"
		aria-valuemin="0"
		aria-valuemax="0"
		aria-valuenow="0"
		aria-disabled="true"
	><span class="np-fill"></span></span>
	<span class="np-time" aria-hidden="true">--:-- / --:--</span>

	<!-- YouTube's player lives here, out of sight. The custom controls above drive it. -->
	<div class="np-embed" aria-hidden="true" inert><div class="np-mount"></div></div>
</section>

<script>
	// The parts of YouTube's IFrame Player API this player uses.
	type Player = {
		playVideo(): void;
		pauseVideo(): void;
		getPlayerState(): number;
		getCurrentTime(): number;
		getDuration(): number;
		seekTo(seconds: number, allowSeekAhead: boolean): void;
	};

	type YT = {
		Player: new (
			el: Element,
			options: {
				videoId: string;
				width: number;
				height: number;
				playerVars: Record<string, number | string>;
				events: {
					onReady: () => void;
					onStateChange: (e: { data: number }) => void;
					onError: () => void;
				};
			},
		) => Player;
	};

	const API_SRC = 'https://www.youtube.com/iframe_api';
	const ENDED = 0;
	const PLAYING = 1;
	const BUFFERING = 3;

	const root = document.querySelector<HTMLElement>('.np');
	if (root) setup(root);

	function setup(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('.np-btn')!;
		const status = root.querySelector<HTMLElement>('.np-status')!;
		const time = root.querySelector<HTMLElement>('.np-time')!;
		const bar = root.querySelector<HTMLElement>('.np-bar')!;
		const mount = root.querySelector<HTMLElement>('.np-mount')!;
		const title = root.querySelector<HTMLElement>('.np-title')!.textContent ?? 'song';
		const videoId = root.dataset.video!;

		let loading: Promise<Player> | null = null;
		let player: Player | null = null;
		let ticker = 0;
		// True while the user drags the bar, so polling doesn't fight the drag.
		let dragging = false;

		const fmt = (sec: number) => {
			const s = Math.max(0, Math.floor(sec));
			return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
		};

		const labels = {
			idle: 'standby',
			loading: 'loading',
			playing: 'now playing',
			paused: 'paused',
			ended: 'ended',
			error: 'no signal',
		};

		const setState = (state: keyof typeof labels) => {
			root.dataset.state = state;
			status.textContent = labels[state];
			btn.setAttribute('aria-label', `${state === 'playing' ? 'Pause' : 'Play'} ${title}`);
			btn.toggleAttribute('aria-busy', state === 'loading');
		};

		const show = (position: number, duration: number) => {
			root.style.setProperty('--np-p', String(Math.min(1, position / duration)));
			time.textContent = `${fmt(position)} / ${fmt(duration)}`;
			bar.setAttribute('aria-valuemax', String(Math.floor(duration)));
			bar.setAttribute('aria-valuenow', String(Math.floor(position)));
			bar.setAttribute('aria-valuetext', `${fmt(position)} of ${fmt(duration)}`);
			bar.removeAttribute('aria-disabled');
		};

		const tick = () => {
			if (!player || dragging) return;
			const duration = player.getDuration();
			if (duration <= 0) return;
			show(player.getCurrentTime(), duration);
		};

		// Seeking only works once YouTube knows the song's length.
		const seekable = () => (player && player.getDuration() > 0 ? player.getDuration() : 0);

		const seek = (position: number) => {
			const duration = seekable();
			if (!player || !duration) return;
			const to = Math.min(Math.max(0, position), duration);
			player.seekTo(to, true);
			show(to, duration);
		};

		// The bar position under the pointer, in seconds.
		const pointerTime = (e: PointerEvent, duration: number) => {
			const r = bar.getBoundingClientRect();
			return (Math.min(Math.max(0, e.clientX - r.left), r.width) / r.width) * duration;
		};

		bar.addEventListener('pointerdown', (e) => {
			const duration = seekable();
			if (!duration || e.button !== 0) return;
			e.preventDefault();
			bar.focus();
			bar.setPointerCapture(e.pointerId);
			dragging = true;
			root.dataset.seeking = '';
			show(pointerTime(e, duration), duration);
		});

		bar.addEventListener('pointermove', (e) => {
			const duration = seekable();
			if (dragging && duration) show(pointerTime(e, duration), duration);
		});

		const endDrag = (e: PointerEvent, commit: boolean) => {
			if (!dragging) return;
			dragging = false;
			delete root.dataset.seeking;
			const duration = seekable();
			if (commit && duration) seek(pointerTime(e, duration));
			else tick();
		};
		bar.addEventListener('pointerup', (e) => endDrag(e, true));
		bar.addEventListener('pointercancel', (e) => endDrag(e, false));

		bar.addEventListener('keydown', (e) => {
			const duration = seekable();
			if (!player || !duration) return;
			const now = player.getCurrentTime();
			const steps: Record<string, number> = {
				ArrowLeft: now - 5,
				ArrowDown: now - 5,
				ArrowRight: now + 5,
				ArrowUp: now + 5,
				PageDown: now - 30,
				PageUp: now + 30,
				Home: 0,
				End: duration,
			};
			if (!(e.key in steps)) return;
			e.preventDefault();
			seek(steps[e.key]);
		});

		// YouTube has no progress event, so the bar is polled while playing.
		const onStateChange = ({ data }: { data: number }) => {
			clearInterval(ticker);
			tick();
			if (data === PLAYING) {
				ticker = window.setInterval(tick, 500);
				setState('playing');
			} else if (data === BUFFERING) setState('loading');
			else if (data === ENDED) setState('ended');
			else setState('paused');
		};

		// Loads YouTube's player API once. Started early on hover or focus,
		// so a click can play right away.
		const load = () => {
			loading ??= new Promise<Player>((resolve, reject) => {
				const w = window as typeof window & { YT?: YT; onYouTubeIframeAPIReady?: () => void };
				w.onYouTubeIframeAPIReady = () => {
					const p = new w.YT!.Player(mount, {
						videoId,
						width: 200,
						height: 200,
						playerVars: { controls: 0, disablekb: 1, playsinline: 1, rel: 0 },
						events: {
							onReady: () => resolve(p),
							onStateChange,
							onError: () => {
								clearInterval(ticker);
								setState('error');
							},
						},
					});
				};
				const s = document.createElement('script');
				s.src = API_SRC;
				s.async = true;
				s.onerror = () => {
					loading = null;
					s.remove();
					reject(new Error('YouTube player API failed to load'));
				};
				document.head.append(s);
			});
			return loading;
		};

		const warm = () => void load().catch(() => {});
		root.addEventListener('pointerenter', warm, { once: true });
		root.addEventListener('focusin', warm, { once: true });
		root.addEventListener('touchstart', warm, { once: true, passive: true });

		btn.addEventListener('click', async () => {
			if (player) {
				if (player.getPlayerState() === PLAYING) player.pauseVideo();
				else player.playVideo();
				return;
			}
			if (root.dataset.state === 'loading') return;
			setState('loading');
			try {
				player = await load();
				player.playVideo();
			} catch {
				setState('error');
			}
		});
	}
</script>
