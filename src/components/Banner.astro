---
// A page title set as big glossy gel type, one span per letter so the
// letters can bob on their own. Purely visual: the real heading is the
// window title below it, so this is hidden from assistive tech.
// `text` must be the page's existing title, never new copy.
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<p class="banner" aria-hidden="true">
	<span class="banner-in">{[...text].map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}</span>
</p>
