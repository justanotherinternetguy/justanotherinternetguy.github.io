---
// A group inside a window's content pane. Each page is one Explorer
// window (see Layout.astro); the sections inside it follow the XP
// "group view": a bold group title over a thin blue rule.
//   headingLevel 1 – the page's own title, set in Franklin Gothic
//                    Medium like the guide's Control Panel header.
//   label          – a count or path, shown in grey after the title;
//                    used as the title when there is none.
// `n` is accepted for old call sites and not shown.
interface Props {
	as?: 'section' | 'article' | 'div';
	n?: string;
	label?: string;
	title?: string;
	headingLevel?: 1 | 2;
	id?: string;
	class?: string;
	style?: string;
}

const { as: Tag = 'section', label, title, headingLevel = 2, id, class: className, style } = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2';
const headingId = title && id ? `${id}-title` : undefined;
---

<Tag class:list={['grp', { 'grp-page': headingLevel === 1 }, className]} id={id} aria-labelledby={headingId} style={style}>
	{
		(title || label) && (
			<header class="grp-head">
				{title ? (
					<Heading class="grp-title" id={headingId}>
						{title}
					</Heading>
				) : (
					<span class="grp-title" aria-hidden="true">
						{label}
					</span>
				)}
				{title && label && (
					<span class="grp-label" aria-hidden="true">
						{label}
					</span>
				)}
				<slot name="bar" />
			</header>
		)
	}
	<div class="grp-body">
		<slot />
	</div>
</Tag>
