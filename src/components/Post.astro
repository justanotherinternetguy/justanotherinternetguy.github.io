---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TaskBox from './TaskBox.astro';
import { formatDate } from '../utils/formatDate';
import { optimizeImages } from '../../scripts/post-images.mjs';
import '../styles/prose.css';
import '../styles/reader.css';

interface Props {
	post: CollectionEntry<'posts'> | CollectionEntry<'daily'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Posts are plain Markdown, so their rendered HTML can be used directly;
// that lets image tags be pointed at resized WebP copies on the way out.
const html = post.rendered?.html ? await optimizeImages(post.rendered.html) : null;

const isDaily = post.collection === 'daily';
const back = isDaily ? { href: '/daily.html', label: 'daily' } : { href: '/posts.html', label: 'all posts' };
const tags = post.collection === 'posts' ? post.data.tags : [];
// Only long, sectioned entries earn an outline in the side rail.
const outline = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showOutline = outline.length >= 3;

---


<Layout title={post.data.title} parent={back}>
	<div class="progress" aria-hidden="true" slot="overlay"></div>
	<article class="post">
		<header class="post-head">
			<h1>{post.data.title}</h1>
			<p class="post-meta">
				<time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
				{tags.map((tag) => <span class="post-tag">{tag}</span>)}
			</p>
		</header>
		<div class="prose">
			{html ? <Fragment set:html={html} /> : <Content />}
		</div>
	</article>

	<Fragment slot="pane">
	{
		showOutline && (
			<TaskBox id="outline" title="contents" special icon={isDaily ? 'cal' : 'doc'} class="outline">
				<ol>
					{outline.map((h) => (
						<li class={`outline-d${h.depth}`}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ol>
			</TaskBox>
		)
	}
	</Fragment>

	<figure class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" slot="overlay">
		<figcaption id="lightbox-caption"></figcaption>
	</figure>
</Layout>

<script>
	const lightbox = document.getElementById('lightbox')!;
	const caption = document.getElementById('lightbox-caption')!;
	// Created on demand so the markup never ships an image without a source.
	const full = document.createElement('img');
	lightbox.prepend(full);

	const close = () => {
		lightbox.removeAttribute('open');
		full.removeAttribute('src');
		document.body.style.overflow = '';
	};

	document.querySelectorAll<HTMLImageElement>('.post img').forEach((img) => {
		img.addEventListener('click', () => {
			full.src = img.dataset.full || img.currentSrc || img.src;
			full.alt = img.alt;
			caption.textContent = img.alt;
			lightbox.setAttribute('open', '');
			document.body.style.overflow = 'hidden';
		});
	});

	lightbox.addEventListener('click', close);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && lightbox.hasAttribute('open')) close();
	});
</script>
