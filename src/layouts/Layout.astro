---
// Every page is one Windows XP Explorer window on a desktop, with the
// taskbar along the bottom of the screen. Built to the Windows XP Visual
// Guidelines (2001): window frame and title bar, toolbar, address bar,
// task pane ("webview"), status bar, taskbar and Start menu.
import '../styles/fonts.css';
import '../styles/global.css';
import NowPlaying from '../components/NowPlaying.astro';
import Icons from '../components/Icons.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import TaskBox from '../components/TaskBox.astro';

interface Props {
	title?: string;
	// The page one level up, for the toolbar's Up button and the top of
	// Other Places. Defaults from the route.
	parent?: { href: string; label: string };
}

const { title = 'Site Title' } = Astro.props;

// e.g. "/posts.html" -> "internetguy.dev/posts", "/" -> "internetguy.dev/"
const route = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/^\//, '');
const brand = `internetguy.dev/${route}`;

const navLinks: { href: string; label: string; icon: IconName; match: (r: string) => boolean }[] = [
	{ href: '/', label: 'home', icon: 'home', match: (r) => r === '' },
	{ href: '/posts.html', label: 'posts', icon: 'folder', match: (r) => r === 'posts' || r.startsWith('posts/') },
	{ href: '/hackathons.html', label: 'hackathons', icon: 'trophy', match: (r) => r === 'hackathons' },
	{ href: '/daily.html', label: 'daily', icon: 'cal', match: (r) => r === 'daily' || r.startsWith('daily/') },
	{ href: '/quotes.html', label: 'quotes', icon: 'quote', match: (r) => r === 'quotes' },
];

// The index page itself is the current page; an entry inside it marks the
// tab as the current location.
const current = (link: (typeof navLinks)[number]) => {
	if (!link.match(route)) return undefined;
	return link.href.replace(/^\/|\.html$/g, '') === route ? 'page' : 'location';
};

const section = navLinks.find((l) => l.match(route));
const inEntry = route.includes('/');
const parent =
	Astro.props.parent ??
	(inEntry && section ? { href: section.href, label: section.label } : route ? { href: '/', label: 'home' } : undefined);

// Title bar icon: the section's own, or a page for a single entry.
const windowIcon: IconName = inEntry ? (route.startsWith('daily/') ? 'cal' : 'doc') : route === 'posts' ? 'folder-open' : (section?.icon ?? 'folder-open');
// Other Places: one level up first, then the rest of the site.
const places = [
	...(parent ? [{ ...parent, icon: (navLinks.find((l) => l.href === parent.href)?.icon ?? 'folder') as IconName }] : []),
	...navLinks.filter((l) => current(l) !== 'page' && l.href !== parent?.href),
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#0054E3" />
		<!-- The two faces every page paints with straight away. -->
		<link rel="preload" href="/fonts/tahoma.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/tahoma-bold.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<!-- Applied before first paint so a motion-off visit never flashes animation. -->
		<script is:inline>
			try {
				if (localStorage.getItem('motion') === 'off') document.documentElement.dataset.motion = 'off';
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip" href="#main">skip to content</a>
		<div class="desktop" aria-hidden="true"></div>
		<Icons />

		<div class="page">
			<div class="win explorer" data-win>
				<div class="win-bar">
					<Icon name={windowIcon} size={16} class="win-ico" />
					<span class="win-title">{title}</span>
					<span class="win-ctl" aria-hidden="true"><i class="ctl-min"></i><i class="ctl-max"></i><i class="ctl-close"></i></span>
				</div>

				<div class="rebar">
					<div class="toolbar" role="toolbar" aria-label="Navigation">
						<button class="tbtn tbtn-text" type="button" data-go="back" hidden>
							<Icon name="back" size={24} />
							<span>Back</span>
						</button>
						<button class="tbtn" type="button" data-go="forward" aria-label="Forward" hidden>
							<Icon name="forward" size={24} />
						</button>
						{
							parent ? (
								<a class="tbtn" href={parent.href} aria-label={`Up to ${parent.label}`} title={`Up to ${parent.label}`}>
									<Icon name="up" size={24} />
								</a>
							) : (
								<span class="tbtn" aria-disabled="true">
									<Icon name="up" size={24} />
								</span>
							)
						}
					</div>
					<div class="addressbar">
						<span class="addr-label" aria-hidden="true">Address</span>
						<span class="addr-field">
							<Icon name={windowIcon} size={16} />
							<span class="addr-text">{brand}</span>
						</span>
					</div>
				</div>

				<div class="explorer-body">
					<main id="main" class="content" tabindex="-1">
						<slot />
					</main>
					<aside class="webview" aria-label="Tasks">
						<div class="webview-in">
							<slot name="pane" />
							<TaskBox id="places" title="Other Places">
								<ul class="tb-links">
									{
										places.map((p) => (
											<li>
												<a href={p.href}>
													<Icon name={p.icon} size={16} />
													<span>{p.label}</span>
												</a>
											</li>
										))
									}
								</ul>
							</TaskBox>
						</div>
					</aside>
				</div>

				<div class="statusbar">
					<span class="sb-panel sb-main">"sometimes in the face of overwhelming odds the only think you can do is make a stink"</span>
					<span class="sb-panel sb-zone"><Icon name="globe" size={16} />internetguy.dev</span>
					<span class="sb-grip" aria-hidden="true"></span>
				</div>
			</div>

			<NowPlaying />
		</div>

		<footer class="taskbar">
			<button class="start" type="button" popovertarget="startmenu" aria-label="Start menu">
				<Icon name="globe" size={24} />
				<span>start</span>
			</button>

			<div class="quicklaunch">
				<a href="https://github.com/justanotherinternetguy" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
					<Icon name="github" size={16} />
				</a>
				<a href="https://mastodon.social/@justanotherinternetguy" target="_blank" rel="me noopener noreferrer" aria-label="Mastodon" title="Mastodon">
					<Icon name="mastodon" size={16} />
				</a>
			</div>

			<nav class="taskband" aria-label="Main">
				{
					navLinks.map((link) => (
						<a class="task" href={link.href} aria-current={current(link)}>
							<Icon name={link.icon} size={16} />
							<span>{link.label}</span>
						</a>
					))
				}
			</nav>

			<div class="tray">
				<button class="motion-toggle tray-btn" type="button" aria-pressed="false" aria-label="Toggle animations" title="Toggle animations">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.1 5.3 5.3 2.1-5.3 2.1L12 17.4l-2.1-5.3-5.3-2.1 5.3-2.1zM5.5 15.2l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9zM18 13.6l.75 1.9 1.9.75-1.9.75-.75 1.9-.75-1.9-1.9-.75 1.9-.75z" /><path class="motion-slash" d="M3.2 2.1L21.9 20.8l-1.1 1.1L2.1 3.2z" /></svg>
				</button>
				<span class="clock" aria-hidden="true"></span>
			</div>
		</footer>

		<slot name="overlay" />

		<div class="startmenu" id="startmenu" popover>
			<div class="sm-head">
				<span class="sm-token"><Icon name="penguin" size={48} /></span>
				<span class="sm-user">Hendry</span>
			</div>
			<div class="sm-cols">
				<nav class="sm-left" aria-label="Pages">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={current(link)}>
										<Icon name={link.icon} size={32} />
										<span>{link.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="sm-right">
					<ul>
						<li>
							<a href="https://github.com/justanotherinternetguy" target="_blank" rel="noopener noreferrer">
								<Icon name="github" size={24} />
								<span>GitHub</span>
							</a>
						</li>
						<li>
							<a href="https://mastodon.social/@justanotherinternetguy" target="_blank" rel="me noopener noreferrer">
								<Icon name="mastodon" size={24} />
								<span>Mastodon</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="sm-foot">
				<button class="motion-toggle sm-power" type="button" aria-pressed="false">
					<Icon name="standby" size={24} />
					<span>Turn Off Animations</span>
				</button>
			</div>
		</div>

		<script is:inline>
			(() => {
				const btns = document.querySelectorAll('.motion-toggle');
				const root = document.documentElement;
				const sync = () => btns.forEach((b) => b.setAttribute('aria-pressed', String(root.dataset.motion === 'off')));
				sync();
				btns.forEach((btn) =>
					btn.addEventListener('click', () => {
						const off = root.dataset.motion !== 'off';
						if (off) root.dataset.motion = 'off';
						else delete root.dataset.motion;
						try {
							localStorage.setItem('motion', off ? 'off' : 'on');
						} catch {}
						sync();
					}),
				);
			})();
		</script>

		<script>
			// Extras on top of a page that works without them: the toolbar's
			// Back and Forward, collapsible task boxes, the tray clock, active
			// and inactive title bars, and draggable windows.

			// ── Back / Forward ──
			type Nav = { canGoBack?: boolean; canGoForward?: boolean };
			const nav = (window as typeof window & { navigation?: Nav }).navigation;
			document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((btn) => {
				const back = btn.dataset.go === 'back';
				btn.hidden = false;
				// Without the Navigation API there's no telling, so both stay usable.
				const can = back ? (nav?.canGoBack ?? history.length > 1) : (nav?.canGoForward ?? true);
				btn.disabled = !can;
				btn.addEventListener('click', () => (back ? history.back() : history.forward()));
			});

			// ── Task boxes collapse from the header ──
			document.querySelectorAll<HTMLElement>('.tb').forEach((box) => {
				const btn = box.querySelector<HTMLButtonElement>('.tb-toggle');
				const head = box.querySelector<HTMLElement>('.tb-head');
				if (!btn || !head) return;
				btn.hidden = false;
				const toggle = () => {
					const open = btn.getAttribute('aria-expanded') !== 'true';
					btn.setAttribute('aria-expanded', String(open));
					box.classList.toggle('is-collapsed', !open);
				};
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					toggle();
				});
				head.addEventListener('click', (e) => {
					if (!(e.target as HTMLElement).closest('a')) toggle();
				});
			});

			// ── Tray clock: "8:20 AM", redrawn on the minute ──
			const clock = document.querySelector<HTMLElement>('.clock');
			if (clock) {
				const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
				const tick = () => {
					const now = new Date();
					clock.textContent = fmt.format(now);
					setTimeout(tick, 60_000 - (now.getSeconds() * 1000 + now.getMilliseconds()) + 50);
				};
				tick();
			}

			// ── One active window at a time ──
			const wins = [...document.querySelectorAll<HTMLElement>('[data-win]')];
			const activate = (win: HTMLElement) => wins.forEach((w) => w.classList.toggle('is-inactive', w !== win));
			const first = wins[0];
			if (first) activate(first);
			const pick = (e: Event) => {
				const win = (e.target as HTMLElement).closest<HTMLElement>('[data-win]');
				if (win) activate(win);
			};
			document.addEventListener('pointerdown', pick);
			document.addEventListener('focusin', pick);

			// ── Drag windows by the title bar; double-click to put one back ──
			if (matchMedia('(hover: hover) and (pointer: fine) and (min-width: 720px)').matches) {
				let top = 2;
				const at = new WeakMap<HTMLElement, [number, number]>();
				const handle = (e: Event) => {
					const t = e.target as HTMLElement;
					if (t.closest('a, button, input, [role="slider"]')) return null;
					return t.closest<HTMLElement>('.win-bar')?.closest<HTMLElement>('[data-win]') ?? null;
				};

				document.addEventListener('pointerdown', (e) => {
					const win = e.button === 0 ? handle(e) : null;
					if (!win) return;
					e.preventDefault();
					const [ox, oy] = at.get(win) ?? [0, 0];
					const sx = e.clientX - ox;
					const sy = e.clientY - oy;
					let x = ox;
					let y = oy;
					let frame = 0;
					win.style.zIndex = String(++top);

					const move = (m: PointerEvent) => {
						x = m.clientX - sx;
						y = m.clientY - sy;
						// One style write per frame, however fast the pointer reports.
						frame ||= requestAnimationFrame(() => {
							frame = 0;
							win.style.translate = `${x}px ${y}px`;
						});
					};
					const drop = () => {
						at.set(win, [x, y]);
						removeEventListener('pointermove', move);
						removeEventListener('pointerup', drop);
						removeEventListener('pointercancel', drop);
					};
					addEventListener('pointermove', move, { passive: true });
					addEventListener('pointerup', drop);
					addEventListener('pointercancel', drop);
				});

				document.addEventListener('dblclick', (e) => {
					const win = handle(e);
					if (!win) return;
					at.delete(win);
					win.style.translate = '';
					win.style.zIndex = '';
				});
			}
		</script>
	</body>
</html>
